{
  "name": "blog-generator",
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "check": "node scripts/check-node-version.js && node src/local/run-check.js",
    "check:fast": "node src/local/run-check.js --fail-fast",
    "test": "node scripts/check-node-version.js && npm run test:unit && npm run test:e2e",
    "test:unit": "node --max-old-space-size=192 scripts/run-jest-with-coverage.js",
    "tsdoc:check": "node --max-old-space-size=384 node_modules/typescript/bin/tsc --project tsconfig.jsdoc.json",
    "test:e2e": "npm run build && node scripts/run-e2e.js",
    "test:e2e:cloud": "node scripts/run-e2e.js --suite cloud",
    "test:e2e:local": "npm run build && node scripts/run-e2e.js --suite local",
    "test:synthetic": "npx playwright test --config test/synthetic.config.ts",
    "generate": "node src/build/generate.js",
    "manuals:check": "node scripts/check-toy-manuals.js",
    "migrate:tree-visibility": "node scripts/migrate-tree-visibility.js",
    "generate:gcp-diagram": "node scripts/generate-gcp-architecture-diagram.js",
    "render:template": "node scripts/render-html-template.js",
    "serve:template-acceptance": "node scripts/serve-template-acceptance.js",
    "gh:watch": "node scripts/watch-gh-run.js",
    "test-watch": "node scripts/run-jest.js --watchAll",
    "tcr": "./tcr.sh",
    "build-and-tcr": "npm run build:browser && npm run tcr",
    "mutant:all": "node --experimental-vm-modules ./node_modules/.bin/stryker run",
    "mutant:worktree": "node src/local/run-stryker-worktree.js",
    "mutant:find": "node src/local/find-surviving-mutant.js",
    "mutant:iterate": "node scripts/mutant-iterate.js",
    "sonar-issues": "src/local/get-sonar-issues.sh",
    "lint": "npx eslint src/core test --cache --cache-location reports/lint/.eslintcache --fix --max-warnings=0 --no-color --format=stylish -o reports/lint/lint.txt && cat reports/lint/lint.txt",
    "copy": "node src/build/copy.js",
    "copy:dendrite": "node src/build/copy-dendrite.js",
    "build:cloud": "node src/build/copy-cloud.js",
    "build:mattheard-net": "npm run copy && npm run generate",
    "build:dendritestories-co-nz": "npm run copy:dendrite",
    "build:browser": "npm run build:mattheard-net",
    "build": "node scripts/check-node-version.js && npm run build:mattheard-net",
    "depcruise": "node src/local/check-depcruise.js",
    "function-graph": "node src/local/function-dependency-graph.js",
    "core-parse": "npm run parse-not-validate && npm run parse-boundary",
    "parse-not-validate": "node src/local/check-parse-not-validate.js",
    "parse-boundary": "node src/local/check-parse-boundary.js",
    "duplication": "node src/local/check-duplication.js",
    "entrypoint-pattern": "node src/local/check-build-entrypoint-pattern.js",
    "non-core-thin": "node src/local/check-non-core-thin-files.js",
    "overexposed-exports": "node src/local/check-overexposed-exports.js",
    "start": "npx serve public",
    "start:symphony": "node src/local/symphony/server.js",
    "start:gcp-simulator": "node src/local/gcp-simulator/server.js",
    "symphony:tui": "node scripts/symphony-tui.js",
    "notion:codex:poll": "node scripts/notion-codex-poll.js",
    "notion:codex:poll:dry": "node scripts/notion-codex-poll.js --dry-run",
    "start:notion-symphony": "node scripts/notion-codex-poll.js --watch",
    "notion:codex:append-reply": "node scripts/notion-codex-append-reply.js",
    "start:writer:playwright": "node src/local/server.js",
    "start:writer": "node src/local/server.js",
    "start:writer:watch": "node --watch src/local/server.js",
    "start:local": "WRITER_HOST=0.0.0.0 node src/local/server.js"
  },
  "devDependencies": {
    "@babel/parser": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@eslint/js": "10.0.1",
    "@playwright/test": "^1.61.0",
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/jest-runner": "^9.6.1",
    "@types/express": "5.0.6",
    "complexity-report": "2.0.0-alpha",
    "cors": "2.8.5",
    "dependency-cruiser": "^17.4.3",
    "dotenv": "16.6.1",
    "escomplex": "2.0.0-alpha",
    "eslint": "10.7.0",
    "eslint-config-prettier": "10.1.5",
    "eslint-plugin-jsdoc": "63.2.2",
    "eslint-plugin-prettier": "5.5.1",
    "express": "^4.22.2",
    "firebase": "^12.14.0",
    "globals": "16.0.0",
    "istanbul-lib-instrument": "^6.0.3",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "jscpd": "4.0.5",
    "madge": "8.0.0",
    "prettier": "3.5.3",
    "typescript": "5.9.3",
    "typhonjs-escomplex": "0.1.0"
  },
  "overrides": {
    "brace-expansion": "5.0.9",
    "js-yaml": "4.3.1",
    "qs": "6.16.0",
    "eslint": {
      "brace-expansion": "5.0.9",
      "minimatch": {
        "brace-expansion": "5.0.9"
      }
    }
  },
  "allowScripts": {
    "@firebase/util@1.15.1": true,
    "core-js@2.6.12": true,
    "protobufjs@7.6.5": true,
    "unrs-resolver@1.12.2": true
  }
}
